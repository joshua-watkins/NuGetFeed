<Project Sdk="WixToolset.Sdk/7.0.1">

	<PropertyGroup>
		<OutputName>NuGetFeed</OutputName>
		<InstallerPlatform>x64</InstallerPlatform>
		<!-- Some .NET runtime files are versioned without a language; that's expected for a self-contained app. -->
		<SuppressIces>ICE60</SuppressIces>
		<!--
			WiX v7 requires accepting the Open Source Maintenance Fee EULA: https://wixtoolset.org/osmf/
			Accepted for this non-commercial project; the fee applies above $10,000 in annual revenue.
		-->
		<AcceptEula>wix7</AcceptEula>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WixToolset.Util.wixext" Version="7.0.1" />
	</ItemGroup>

	<ItemGroup>
		<!--
			Publish the Windows service as a self-contained app so the target machine doesn't need
			the .NET runtime. The publish output is available to the .wxs files as !(bindpath.Windows).
		-->
		<ProjectReference Include="..\Windows\Windows.csproj"
						  Publish="true"
						  AdditionalProperties="SolutionName=NuGetFeed;RuntimeIdentifier=win-x64;SelfContained=true" />
	</ItemGroup>

</Project>
