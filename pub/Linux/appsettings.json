{
  "ApiKey": "",
  "PackageDeletionBehavior": "Unlist",
  "AllowPackageOverwrites": false,

  // Where clients like Visual Studio link to a package's page on the website. Only advertised over HTTPS.
  "PackageDetailsUriTemplate": "packages/{id}/{version}",

  // Uncomment this to repository sign pushed packages with a code signing certificate.
  //"RepositorySigning": {
  //  "CertificatePath": "signing.pfx",
  //  "CertificatePassword": "",
  //  "TimestampServerUrl": "http://timestamp.digicert.com"
  //},

  "Database": {
    "Type": "Sqlite",
    "ConnectionString": "Data Source=/var/lib/nugetfeed/nugetfeed.db"
  },

  // systemd creates /var/lib/nugetfeed for the service (StateDirectory= in nugetfeed.service).
  "Storage": {
    "Type": "FileSystem",
    "Path": "/var/lib/nugetfeed"
  },

  "Search": {
    "Type": "Database"
  },

  "Mirror": {
    // Enabling mirror will ensure that all packages used are copied to the local server
    "Enabled": true,

    // The NuGet V3 feed to mirror.
    "PackageSource": "https://api.nuget.org/v3/index.json"
  },

  // The website reads packages through the NuGet V3 API. By default it uses the server
  // hosted in this application. Uncomment this to show packages from another feed instead.
  //"Website": {
  //  "ServiceIndexUrl": "https://feed.example.com/v3/index.json"
  //},

  // Uncomment this to configure NuGetFeed to listen to port 8080.
  // See: https://docs.microsoft.com/en-us/aspnet/core/fundamentals/servers/kestrel?view=aspnetcore-3.1#listenoptionsusehttps
  //"Kestrel": {
  //  "Endpoints": {
  //    "Http": {
  //      "Url": "http://localhost:8080"
  //    }
  //  }
  //},

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "LogLevel": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Default": "Warning"
      }
    }
  }
}
