{
  // Development uses an in-memory database and a temporary package folder, which start empty
  // each time the app starts.
  "Database": {
    "ConnectionString": "Data Source=NuGetFeed;Mode=Memory;Cache=Shared"
  },

  "Storage": {
    "Temporary": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
