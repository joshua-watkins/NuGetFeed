{
  "ApiKey": "",
  "PackageDeletionBehavior": "Unlist",
  "AllowPackageOverwrites": false,

  // A Windows Service's working directory is C:\Windows\System32, so use absolute paths.
  "Database": {
    "Type": "Sqlite",
    "ConnectionString": "Data Source=C:\\ProgramData\\NuGetFeed\\nugetfeed.db"
  },

  "Storage": {
    "Type": "FileSystem",
    "Path": "C:\\ProgramData\\NuGetFeed"
  },

  "Search": {
    "Type": "Database"
  },

  "Mirror": {
    // Enabling mirror will ensure that all packages used are copied to the local server
    "Enabled": true,
    // Uncomment this to use the NuGet v2 protocol
    //"Legacy": true,
    "PackageSource": "https://api.nuget.org/v3/index.json"
  },

  // The website reads packages through the NuGet V3 API. By default it uses the server
  // hosted in this application. Uncomment this to show packages from another feed instead.
  //"Website": {
  //  "ServiceIndexUrl": "https://feed.example.com/v3/index.json"
  //},

  "Logging": {
    "Console": {
      "LogLevel": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Default": "Warning"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
