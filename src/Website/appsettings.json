{
  "Website": {
    // The NuGet V3 feed the website shows, for example "https://feed.example.com/v3/index.json".
    // Required when the website runs on its own. Leave it empty when the website is hosted
    // with the server: the website then reads the feed from its own application.
    "ServiceIndexUrl": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Default": "Warning"
      }
    }
  }
}
