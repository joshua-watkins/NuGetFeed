<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<AssemblyName>$(SolutionName).$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>$(SolutionName)</RootNamespace>
		<IsAotCompatible>true</IsAotCompatible>
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
		<!-- Generates the minimal API endpoints' request handling at compile time instead of with reflection. -->
		<EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
		<!-- Razor Slices compiles the pages with the Razor compiler's MVC support. The website doesn't use MVC at runtime. -->
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<!-- Serve the website's files at the same path whether it runs on its own or inside a host. -->
		<StaticWebAssetBasePath>_content/NuGetFeed.Website</StaticWebAssetBasePath>
		<!-- The Windows installer (pub/Setup) publishes the Windows service, which references this project, for win-x64. -->
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Humanizer" Version="3.0.10" />
		<PackageReference Include="Markdig" Version="1.5.0" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="RazorSlices" Version="0.12.2" />
	</ItemGroup>

	<PropertyGroup>
		<EnableDefaultRazorSlices>false</EnableDefaultRazorSlices>
	</PropertyGroup>
	<ItemGroup>
		<!-- Only treat .cshtml files in Slices directory as Razor Slices. The layout is a slice too. -->
		<RazorSlice Include="Slices\**\*.cshtml" Exclude="Slices\**\_ViewImports.cshtml" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The tests create the pages' models directly. -->
		<InternalsVisibleTo Include="$(SolutionName).Website.Tests" />
	</ItemGroup>

</Project>
