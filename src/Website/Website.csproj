<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>$(SolutionName).$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>$(SolutionName)</RootNamespace>
		<IsAotCompatible>true</IsAotCompatible>
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
		<RazorCompileOnBuild>true</RazorCompileOnBuild>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<!-- Switch to Razor Slices which are AOT compatible. -->
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Humanizer" Version="3.0.10" />
		<PackageReference Include="Markdig" Version="1.5.0" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="RazorSlices" Version="0.12.2" />
	</ItemGroup>

	<PropertyGroup>
		<EnableDefaultRazorSlices>false</EnableDefaultRazorSlices>
	</PropertyGroup>
	<ItemGroup>
		<!-- Only treat .cshtml files in Slices directory as Razor Slices -->
		<RazorSlice Include="Slices\**\*.cshtml" Exclude="Slices\**\_Layout.cshtml;Slices\**\_ViewImports.cshtml" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\Core.csproj" />
	</ItemGroup>

</Project>
