@inherits RazorSlice<FeedErrorModel>
@implements IUsesLayout<_Layout, LayoutModel>

<div>
    <h2>Oops, the feed isn't responding...</h2>
    <p>The website couldn't read the NuGet feed at <code>@Model.ServiceIndexUrl</code>.</p>
    <p>
        Make sure the feed is running and reachable from the website. When the website runs on its own,
        the <code>Website:ServiceIndexUrl</code> setting chooses the feed.
    </p>
</div>

@functions {
    public LayoutModel LayoutModel => new("Feed unavailable", Model.PathBase);
}
