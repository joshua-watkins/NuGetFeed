@inherits RazorLayoutSlice<LayoutModel>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="NuGetFeed">

    <link rel="shortcut icon" href="@Model.Content("favicon.ico")">

    <link rel="stylesheet" href="@Model.Content("lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Model.Content("lib/office-ui-fabric-core/dist/css/fabric.min.css")" />
    <link rel="stylesheet" href="@Model.Content("css/site.css")" />

    <title>@Model.Title - NuGetFeed</title>
</head>
<body>
    <header>

        <nav class="navbar navbar-inverse" role="navigation">
            <div class="container">
                <div class="row">
                    <div id="navbar" class="col-sm-12">
                        <ul class="nav navbar-nav" role="tablist">
                            <li role="presentation"><a href="@Model.PathBase/" role="tab" class="@(Model.ActivePage == WebsitePage.Packages ? "active" : null)"><span>Packages</span></a></li>
                            <li role="presentation"><a href="@Model.PathBase/upload" role="tab" class="@(Model.ActivePage == WebsitePage.Upload ? "active" : null)"><span>Upload</span></a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="container search-container">
                <div class="row">
                    <form class="col-sm-12" action="@Model.PathBase/" method="get">
                        <div class="input-group">
                            <input type="text"
                                   name="q"
                                   value="@Model.SearchQuery"
                                   class="form-control"
                                   autoComplete="off"
                                   placeholder="Search packages..." />

                            <span class="input-group-btn">
                                <button type="submit"
                                        class="btn btn-default"
                                        title="Search for packages">
                                    <span class="ms-Icon ms-Icon--Search" aria-hidden="true"></span>
                                </button>
                            </span>
                        </div>

                        @await RenderSectionAsync("SearchForm")
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <section role="main" class="container main-container">
        @await RenderBodyAsync()
    </section>

    <script src="@Model.Content("lib/alpinejs/dist/alpine.js")"></script>

    <script src="@Model.Content("lib/jquery/dist/jquery.min.js")"></script>
    <script src="@Model.Content("lib/bootstrap/dist/js/bootstrap.min.js")"></script>
    <script src="@Model.Content("js/site.js")"></script>
</body>
</html>
