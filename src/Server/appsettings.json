{
  "ApiKey": "",
  "PackageDeletionBehavior": "HardDelete",
  "AllowPackageOverwrites": true,

  // Uncomment this to give clients like Visual Studio a link to a package's page. Only advertised over HTTPS.
  //"PackageDetailsUriTemplate": "https://nuget.example.com/packages/{id}/{version}",

  // Uncomment this to repository sign pushed packages with a code signing certificate.
  //"RepositorySigning": {
  //  "CertificatePath": "signing.pfx",
  //  "CertificatePassword": "",
  //  "TimestampServerUrl": "http://timestamp.digicert.com"
  //},

  "Database": {
    "Type": "Sqlite",
    "ConnectionString": "Data Source=nuget.db"
  },

  "Storage": {
    "Type": "FileSystem",
    "Path": "/packages"
  },

  "Search": {
    "Type": "Database"
  },

  "Mirror": {
    "Enabled": false,
    "PackageSource": "https://api.nuget.org/v3/index.json"
  },

  // Uncomment this to configure NuGetFeed to listen to port 8080.
  // See: https://docs.microsoft.com/en-us/aspnet/core/fundamentals/servers/kestrel?view=aspnetcore-3.1#listenoptionsusehttps
  //"Kestrel": {
  //  "Endpoints": {
  //    "Http": {
  //      "Url": "http://localhost:8080"
  //    }
  //  }
  //},

  "Logging": {
    "Debug": {
      "LogLevel": {
        "Default": "Warning"
      }
    },
    "Console": {
      "LogLevel": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Default": "Warning"
      }
    }
  }
}
