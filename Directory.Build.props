<Project>

	<!--
		The projects name their assemblies and namespaces after the solution. Use the same name when a
		project is built or run on its own, like when "dotnet run" is given the website's project file.
	-->
	<PropertyGroup Condition="'$(SolutionName)' == '' Or '$(SolutionName)' == '*Undefined*'">
		<SolutionName>NuGetFeed</SolutionName>
	</PropertyGroup>

</Project>
